{
  "dataRoles": [
    {
      "name": "latitude",
      "kind": "Grouping",
      "displayName": "Latitude",
      "description": "Latitude column (decimal degrees, e.g. 40.4168)"
    },
    {
      "name": "longitude",
      "kind": "Grouping",
      "displayName": "Longitude",
      "description": "Longitude column (decimal degrees, e.g. -3.7038)"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value",
      "description": "Numeric value to color each tile"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "description": "Additional fields shown in tooltip"
    },
    {
      "name": "label",
      "kind": "Grouping",
      "displayName": "Label",
      "description": "Optional display name (city, region...)"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "latitude": {
            "max": 1
          },
          "longitude": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "tooltips": {
            "max": 10
          },
          "label": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "latitude"
              }
            },
            {
              "for": {
                "in": "longitude"
              }
            },
            {
              "for": {
                "in": "label"
              }
            },
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "mapSettings": {
      "properties": {
        "country": {
          "type": {
            "enumeration": [
              {
                "value": "es",
                "displayName": "Spain"
              },
              {
                "value": "ic",
                "displayName": "Canarias (Spain)"
              },
              {
                "value": "pt",
                "displayName": "Portugal"
              },
              {
                "value": "fr",
                "displayName": "France"
              },
              {
                "value": "de",
                "displayName": "Germany"
              },
              {
                "value": "it",
                "displayName": "Italy"
              },
              {
                "value": "it_islands",
                "displayName": "Sicily (Italy)"
              },
              {
                "value": "it_sardinia",
                "displayName": "Sardinia (Italy)"
              },
              {
                "value": "gb",
                "displayName": "United Kingdom"
              },
              {
                "value": "nl",
                "displayName": "Netherlands"
              },
              {
                "value": "be",
                "displayName": "Belgium"
              },
              {
                "value": "pl",
                "displayName": "Poland"
              },
              {
                "value": "se",
                "displayName": "Sweden"
              },
              {
                "value": "no",
                "displayName": "Norway"
              },
              {
                "value": "ch",
                "displayName": "Switzerland"
              },
              {
                "value": "at",
                "displayName": "Austria"
              },
              {
                "value": "us",
                "displayName": "United States"
              },
              {
                "value": "ak",
                "displayName": "Alaska (USA)"
              },
              {
                "value": "hi",
                "displayName": "Hawaii (USA)"
              },
              {
                "value": "ca",
                "displayName": "Canada"
              },
              {
                "value": "mx",
                "displayName": "Mexico"
              },
              {
                "value": "br",
                "displayName": "Brazil"
              },
              {
                "value": "ar",
                "displayName": "Argentina"
              },
              {
                "value": "co",
                "displayName": "Colombia"
              },
              {
                "value": "au",
                "displayName": "Australia"
              },
              {
                "value": "in",
                "displayName": "India"
              },
              {
                "value": "jp",
                "displayName": "Japan"
              },
              {
                "value": "custom",
                "displayName": "Custom TopoJSON (Pro)"
              }
            ]
          }
        },
        "aggregationType": {
          "type": {
            "enumeration": [
              { "value": "sum",     "displayName": "Sum" },
              { "value": "average", "displayName": "Average" },
              { "value": "count",   "displayName": "Count" },
              { "value": "min",     "displayName": "Min" },
              { "value": "max",     "displayName": "Max" }
            ]
          }
        },
        "showEmptyCells": {
          "type": {
            "bool": true
          }
        },
        "showLabels": {
          "type": {
            "bool": true
          }
        },
        "labelFontSize": {
          "type": {
            "numeric": true
          }
        },
        "labelMinTileSize": {
          "type": { "numeric": true }
        },
        "tooltipDecimals": {
          "type": { "numeric": true }
        }
      }
    },
    "colorScale": {
      "properties": {
        "scaleType": {
          "type": {
            "enumeration": [
              {
                "value": "sequential",
                "displayName": "Sequential"
              },
              {
                "value": "diverging",
                "displayName": "Diverging (Pro)"
              },
              {
                "value": "categorical",
                "displayName": "Categorical (Pro)"
              }
            ]
          }
        },
        "colorMin": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "colorMid": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "colorMax": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "noDataColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "legend": {
      "properties": {
        "showLegend": {
          "type": {
            "bool": true
          }
        },
        "legendPosition": {
          "type": {
            "enumeration": [
              {
                "value": "bottom",
                "displayName": "Bottom"
              },
              {
                "value": "right",
                "displayName": "Right"
              },
              {
                "value": "top",
                "displayName": "Top"
              }
            ]
          }
        }
      }
    },
    "accessibility": {
      "properties": {
        "showBorders":      { "type": { "bool": true } },
        "borderColor":      { "type": { "fill": { "solid": { "color": true } } } },
        "borderWidth":      { "type": { "numeric": true } },
        "selectedRingColor": { "type": { "fill": { "solid": { "color": true } } } },
        "selectedRingWidth": { "type": { "numeric": true } }
      }
    },
    "conditionalFormatting": {
      "properties": {
        "cfEnabled": { "type": { "bool": true } },
        "cfRule1Operator": {
          "type": {
            "enumeration": [
              { "value": "lt",  "displayName": "< Less than" },
              { "value": "lte", "displayName": "≤ Less than or equal" },
              { "value": "gt",  "displayName": "> Greater than" },
              { "value": "gte", "displayName": "≥ Greater than or equal" },
              { "value": "eq",  "displayName": "= Equal to" }
            ]
          }
        },
        "cfRule1Value": { "type": { "numeric": true } },
        "cfRule1Color": { "type": { "fill": { "solid": { "color": true } } } },
        "cfRule2MinValue": { "type": { "numeric": true } },
        "cfRule2MaxValue": { "type": { "numeric": true } },
        "cfRule2Color": { "type": { "fill": { "solid": { "color": true } } } },
        "cfRule3Operator": {
          "type": {
            "enumeration": [
              { "value": "lt",  "displayName": "< Less than" },
              { "value": "lte", "displayName": "≤ Less than or equal" },
              { "value": "gt",  "displayName": "> Greater than" },
              { "value": "gte", "displayName": "≥ Greater than or equal" },
              { "value": "eq",  "displayName": "= Equal to" }
            ]
          }
        },
        "cfRule3Value": { "type": { "numeric": true } },
        "cfRule3Color": { "type": { "fill": { "solid": { "color": true } } } }
      }
    },
    "proSettings": {
      "properties": {
        "customTopoJsonUrl": {
          "type": { "text": true }
        },
        "showPill": {
          "type": { "bool": true }
        },
        "topoJsonContent": {
          "type": { "text": true }
        },
        "topoJsonFileName": {
          "type": { "text": true }
        }
      }
    }
  },
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsSynchronizingFilterState": true,
  "supportsMultiVisualSelection": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "privileges": [],
  "supportsLandingPage": true,
  "supportsEmptyDataView": true
}