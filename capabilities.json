{
  "dataRoles": [
    {
      "name": "latitude",
      "kind": "Grouping",
      "displayName": "Latitude", "displayNameKey": "Visual_Latitude",
      "description": "Latitude column (decimal degrees, e.g. 40.4168)", "descriptionKey": "Visual_Desc_Latitude"
    },
    {
      "name": "longitude",
      "kind": "Grouping",
      "displayName": "Longitude", "displayNameKey": "Visual_Longitude",
      "description": "Longitude column (decimal degrees, e.g. -3.7038)", "descriptionKey": "Visual_Desc_Longitude"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value", "displayNameKey": "Visual_Value",
      "description": "Numeric value to color each tile", "descriptionKey": "Visual_Desc_Value"
    },
    {
      "name": "size",
      "kind": "Measure",
      "displayName": "Size (Pro)", "displayNameKey": "Visual_Size",
      "description": "Optional second measure that sizes each tile", "descriptionKey": "Visual_Desc_Size"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips", "displayNameKey": "Visual_Tooltips",
      "description": "Additional fields shown in tooltip", "descriptionKey": "Visual_Desc_Tooltips"
    },
    {
      "name": "label",
      "kind": "Grouping",
      "displayName": "Label", "displayNameKey": "Visual_Label",
      "description": "Optional display name (city, region...)", "descriptionKey": "Visual_Desc_Label"
    },
    {
      "name": "category",
      "kind": "Grouping",
      "displayName": "Category", "displayNameKey": "Visual_Category",
      "description": "Group used by the Categorical colour scale (Pro): each tile takes the category with most rows"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "latitude": {
            "max": 1
          },
          "longitude": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "tooltips": {
            "max": 10
          },
          "label": {
            "max": 1
          },
          "size": {
            "max": 1
          },
          "category": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "latitude"
              }
            },
            {
              "for": {
                "in": "longitude"
              }
            },
            {
              "for": {
                "in": "label"
              }
            },
            {
              "for": {
                "in": "category"
              }
            },
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            },
            {
              "bind": {
                "to": "size"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
